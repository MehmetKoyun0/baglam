{
  "name": "baglam",
  "version": "1.0.2",
  "description": "Shared, human-approved project memory and seamless handoff for AI coding agents (Claude Code, Codex, Cursor, Antigravity, Gemini CLI, VS Code, Windsurf) over MCP. Local-first.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "antigravity",
    "gemini-cli",
    "memory",
    "context",
    "llm"
  ],
  "license": "MIT",
  "author": "Bağlam contributors",
  "homepage": "https://github.com/Mehmet274634/baglam#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mehmet274634/baglam.git"
  },
  "bugs": {
    "url": "https://github.com/Mehmet274634/baglam/issues"
  },
  "type": "module",
  "bin": {
    "baglam": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "README.tr.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config ui/vite.config.ts --logLevel warn",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json",
    "prepack": "npm run build",
    "smoke": "node scripts/pack-smoke.mjs",
    "test:perf": "node scripts/test-perf.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "preact": "^11.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
