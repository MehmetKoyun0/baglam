---
/** Centred page opening with a light effect behind it: eyebrow, two-tone headline, lead, extras. */
import PageFx, { type Fx } from "./PageFx.astro";
interface Props { eyebrow?: string; title: string; dim?: string; lead?: string; fx?: Fx }
const { eyebrow, title, dim, lead, fx = "rays" } = Astro.props;
---

<section class="page-hero wrap">
  <PageFx fx={fx} />
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="display two-tone">{title}{dim && <> <span class="dim">{dim}</span></>}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</section>

<style>
  .page-hero {
    position: relative;
    justify-items: center;
    text-align: center;
    isolation: isolate;
    padding-top: clamp(140px, 19vw, 220px) !important;
  }
  .page-hero :global(.display) {
    max-width: 18ch;
    animation: enter 1s var(--ease) both;
  }
  .page-hero :global(.lead) {
    margin-inline: auto;
    animation: enter 1s 120ms var(--ease) both;
  }
  .page-hero :global(.eyebrow) {
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 9%);
    background: rgb(8 9 10 / 55%);
    backdrop-filter: blur(6px);
    animation: enter 1s var(--ease) both;
  }
  /* Phones: the title sits just under the navigation bar. */
  @media (max-width: 640px) {
    .page-hero {
      padding-top: 40px !important;
      padding-bottom: 40px !important;
      gap: 18px;
    }
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-hero :global(.display),
    .page-hero :global(.lead),
    .page-hero :global(.eyebrow) {
      animation: none;
    }
  }
</style>
